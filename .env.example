# ---------------------------------------------------------------------------
# Financial Parallelverse — example configuration
# Copy this file to .env for backend overrides. Do not commit .env.
# Frontend overrides live in frontend/.env (see frontend/.env.example).
# ---------------------------------------------------------------------------

# API metadata and environment
APP_NAME=Financial Parallelverse API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1

# SQLite database. The default is <repo>/data/financial_parallelverse.db.
# Use an absolute path if you override it:
# DATABASE_URL=sqlite:////absolute/path/to/financial_parallelverse.db

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the fictional demo profile on first launch. Existing data is preserved.
SEED_DEMO=true
