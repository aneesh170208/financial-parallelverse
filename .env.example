# ---------------------------------------------------------------------------
# Financial Parallelverse — example configuration
# Copy this file to .env for local overrides. Do not commit .env.
# ---------------------------------------------------------------------------

# API metadata and environment
APP_NAME=Financial Parallelverse API
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api/v1

# SQLite database. The default is <repo>/data/financial_parallelverse.db.
# Use an absolute path if you override it:
# DATABASE_URL=sqlite:////absolute/path/to/financial_parallelverse.db

# Comma-separated browser origins allowed to call the API directly.
# The Streamlit server calls FastAPI server-side, so this is only needed for
# browser-based API clients.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Seed the fictional demo profile on first launch. Existing data is preserved.
SEED_DEMO=true

# Streamlit interface → FastAPI base URL.
# The dev script sets this automatically to http://127.0.0.1:8000/api/v1.
# In Docker Compose it is set to http://backend:8000/api/v1.
API_URL=http://127.0.0.1:8000/api/v1
